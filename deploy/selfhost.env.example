# Copy to .env beside compose.yaml. No passwords belong in this file.
TEXTDROP_IMAGE=ghcr.io/darkrise12/textdrop:1.1.1
TEXTDROP_BIND=127.0.0.1
TEXTDROP_PORT=8765
# 1 for HTTPS reverse proxy; 0 ONLY for HTTP on localhost during evaluation.
TEXTDROP_SECURE=1
# Bytes: 125 MiB per file, 3 GiB total across all users including trash/previews.
TEXTDROP_FILE_LIMIT=131072000
TEXTDROP_STORAGE_LIMIT=3221225472
